# ---- Required ---------------------------------------------------------------
# Supabase (Project Settings > API). The Vercel Marketplace integration sets these for you.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction-pooler connection string (Settings > Database). Integration sets POSTGRES_URL instead.
DATABASE_URL=postgres://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# First login with this email creates the workspace and its owner.
OWNER_EMAIL=you@yourcompany.com

# Resend (resend.com): API key + a from-address on a verified domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=sign@yourcompany.com

# Random secrets: openssl rand -hex 32
TOKEN_PEPPER=
CRON_SECRET=

# ---- Optional ---------------------------------------------------------------
# APP_URL=https://sign.yourcompany.com
# DATABASE_URL_SESSION=            # session pooler, used by migrations only
# WORKSPACE_NAME=Acme Inc
# EMAIL_FROM_NAME=Acme Sign

# Branding (NEXT_PUBLIC_* are baked in at build time)
# NEXT_PUBLIC_BRAND_NAME=Imagine Sign
# NEXT_PUBLIC_COMPANY_NAME=Acme Inc.
# NEXT_PUBLIC_BRAND_LOGO=/brand/your-logo.svg
# NEXT_PUBLIC_BRAND_EMAIL_LOGO=/brand/your-logo.png
# NEXT_PUBLIC_BRAND_MARK=/brand/your-mark.svg
# NEXT_PUBLIC_STAMP_LABEL=Acme Signed by:
# NEXT_PUBLIC_SUPPORT_EMAIL=help@yourcompany.com
# NEXT_PUBLIC_SHOW_POWERED_BY=true
# BRAND_ACCENT_COLOR=#f6a1a8
# BRAND_ACCENT_INK=#955c67

# PAdES seal. Leave empty to auto-generate a self-signed certificate on first use.
# SEAL_P12_BASE64=
# SEAL_P12_PASSPHRASE=
# SEAL_AUTO_GENERATE=true
# SEAL_LOCATION=

# SKIP_MIGRATIONS=1
